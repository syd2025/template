// Rewrite the crate name so the generated project matches the requested
// project name instead of the template's own `template` package name.
// The Rhai `file` module has no read API, so the manifest and lock file are
// rewritten from scratch here.
let crate_name = variable::get("crate_name");
if crate_name == "template" {
    return;
}

let manifest = "[package]\n"
    + "name = \"" + crate_name + "\"\n"
    + "version = \"0.1.0\"\n"
    + "edition = \"2024\"\n"
    + "\n"
    + "# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html\n"
    + "\n"
    + "[dependencies]\n"
    + "anyhow = \"1.0\"\n";
file::write("Cargo.toml", manifest);

let lock = "# This file is automatically @generated by Cargo.\n"
    + "# It is not intended for manual editing.\n"
    + "version = 4\n"
    + "\n"
    + "[[package]]\n"
    + "name = \"anyhow\"\n"
    + "version = \"1.0.104\"\n"
    + "source = \"registry+https://github.com/rust-lang/crates.io-index\"\n"
    + "checksum = \"330a5ed07fa54e4702c9d6c4174f74427fc0ef6e214bbd677ae50a5099946470\"\n"
    + "\n"
    + "[[package]]\n"
    + "name = \"" + crate_name + "\"\n"
    + "version = \"0.1.0\"\n"
    + "dependencies = [\n"
    + " \"anyhow\",\n"
    + "]\n";
file::write("Cargo.lock", lock);
